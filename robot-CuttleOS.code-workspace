{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": true,
		"python.formatting.provider": "black",
		"[python]": {
			"editor.defaultFormatter": "ms-python.python",
			"editor.formatOnSave": true,
			"editor.codeActionsOnSave": {
				"source.organizeImports": "explicit"
			}
		},
		"[typescript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[json]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode"
		},
		"files.exclude": {
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/node_modules": true,
			"**/.pytest_cache": true,
			"**/.venv": true
		},
		"files.watcherExclude": {
			"**/__pycache__": true,
			"**/node_modules": true,
			"**/venv": true,
			".git": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/__pycache__": true,
			".git": true,
			"venv": true
		},
		"editor.rulers": [88, 120],
		"editor.trimAutoWhitespace": true,
		"files.trimTrailingWhitespace": true,
		"python.testing.pytestEnabled": true,
		"python.testing.pytestArgs": ["tests"],
		"editor.wordWrap": "on",
		"chat.tools.terminal.autoApprove": {
			"mkdir": true,
			"cp": true,
			"true": true
		}
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python: Cockpit",
				"type": "python",
				"request": "launch",
				"module": "uvicorn",
				"args": ["rov_cockpit.app:app", "--reload", "--host", "0.0.0.0", "--port", "8080"],
				"cwd": "${workspaceFolder}/cockpit/src",
				"console": "integratedTerminal"
			},
			{
				"name": "Python: Control",
				"type": "python",
				"request": "launch",
				"module": "rov_control.main",
				"cwd": "${workspaceFolder}/control/src",
				"console": "integratedTerminal"
			},
			{
				"name": "Python: Datalogger",
				"type": "python",
				"request": "launch",
				"module": "rov_datalogger.main",
				"cwd": "${workspaceFolder}/datalogger/src",
				"console": "integratedTerminal"
			}
		]
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"esbenp.prettier-vscode",
			"dbaeumer.vscode-eslint",
			"ms-vscode.makefile-tools",
			"redhat.vscode-yaml",
			"ms-vscode-remote.remote-ssh",
			"FanaticPythoner.better-todo-tree"
		]
	}
}