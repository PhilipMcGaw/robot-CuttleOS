# Copy this file to configs/nats.env. The provisioner derives the authenticated
# loopback NATS_URL for robot services from network.secrets.env.
NATS_REMOTE_ACCESS=false
# Set true only for HiL/SiL or another explicitly trusted client network.
# The deployed server still requires NATS_USERNAME and NATS_PASSWORD from the
# ignored network.secrets.env file.
