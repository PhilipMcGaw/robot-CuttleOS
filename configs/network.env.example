# Non-secret Raspberry Pi network deployment settings.
NETWORK_INTERFACE=eth0
WIFI_INTERFACE=wlan0
WIRED_CONNECTION_NAME=robot-wired
WIRED_DHCP=true
# Required only when WIRED_DHCP=false. Do not reuse the wireless-hotspot
# subnet on a wired interface while the hotspot can be active.
WIRED_STATIC_ADDRESS=
WIRED_GATEWAY=
WIFI_CONNECTION_PREFIX=robot-wifi
HOTSPOT_CONNECTION_NAME=robot-hotspot
HOTSPOT_SSID=robot
FALLBACK_ROBOT_ADDRESS=192.168.42.1/24
HOTSPOT_CHANNEL=6
ROBOT_HOSTNAME=robot
MEDIA_ROOT=${COCKPIT_ROOT}/media
SMB_SHARE_NAME=media
SMB_USER=${ROBOT_RUNTIME_USER}
