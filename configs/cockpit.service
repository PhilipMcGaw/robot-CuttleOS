[Unit]
Description=ROV Cockpit web application
After=network.target

[Service]
User=@ROBOT_USER@
WorkingDirectory=@COCKPIT_ROOT@
EnvironmentFile=-/etc/robot/nats.env
ExecStart=/bin/bash "@COCKPIT_ROOT@/apps/cockpit/run.sh"
Environment=MAP_TILE_PROXY=true
Environment=CSV_ROOT=@COCKPIT_ROOT@/data/csv
Restart=always
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
