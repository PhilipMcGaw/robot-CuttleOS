{% extends "base.jinja" %}
{% block title %}map — ROV{% endblock %}
{% block content %}

<title>ROV Map</title>
    <link rel="stylesheet" href="/static/css/leaflet.css" />
    <style>
        html, body { height: 100%; margin: 0; }
        #map { height: calc(100vh - 60px); width: 100%; }
    </style>
    <div id="map"></div>
{% endblock %}
{% block scripts %}
<script src="/static/js/leaflet.js"></script>
<script>
        const map = L.map('map').setView([52.16900980550594, -1.2140212752292743], 19);

        const tilePrefix = {{ map_tile_prefix|tojson }};
        const osmUrl = tilePrefix ? tilePrefix + '/osm/{z}/{x}/{y}.png' : 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
        const seamarkUrl = tilePrefix ? tilePrefix + '/seamarks/{z}/{x}/{y}.png' : 'https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png';
        const osm = L.tileLayer(osmUrl, {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const seamarks = L.tileLayer(seamarkUrl, {
            maxZoom: 18,
            attribution: '&copy; OpenSeaMap (seamarks) — Data: OpenSeaMap / OpenStreetMap contributors',
            opacity: 0.9
        }).addTo(map);

        L.control.layers(
            { 'OpenStreetMap': osm },
            { 'SeaMarks (OpenSeaMap)': seamarks },
            { collapsed: false }
        ).addTo(map);
    </script>
{% endblock %}
