{% extends "base.jinja" %}
{% block title %}simulator — ROV{% endblock %}
{% block content %}

<main class="container py-4">
  <h1><i class="fa-solid fa-flask"></i> Development sensor simulator</h1>
  <p id="simulationWarning" class="alert alert-secondary">Simulation mode is off. Enable it before sending fake telemetry.</p>
  <div class="card bg-dark-subtle p-3 mb-3"><label class="form-check form-switch"><input id="simulationEnabled" class="form-check-input" type="checkbox"><span class="form-check-label">Simulation mode</span></label><small>When enabled, slider values are injected into the Cockpit telemetry stream. The mode resets to off when Cockpit restarts unless enabled by configuration.</small></div>
  <div class="card bg-dark-subtle p-3">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Depth <output data-output="depth"></output></label><input class="form-range" data-topic="sensor/water/depth" data-name="depth" type="range" min="-150" max="10" step="0.01" value="0"></div>
      <div class="col-md-6"><label class="form-label">Heading <output data-output="heading"></output></label><input class="form-range" data-topic="sensor/ahrs/imu/heading" data-name="heading" type="range" min="0" max="359" step="1" value="0"></div>
      <div class="col-md-6"><label class="form-label">Pitch <output data-output="pitch"></output></label><input class="form-range" data-topic="sensor/ahrs/imu/pitch" data-name="pitch" type="range" min="-45" max="45" step="0.1" value="0"></div>
      <div class="col-md-6"><label class="form-label">Roll <output data-output="roll"></output></label><input class="form-range" data-topic="sensor/ahrs/imu/roll" data-name="roll" type="range" min="-45" max="45" step="0.1" value="0"></div>
      <div class="col-md-6"><label class="form-label">Battery voltage <output data-output="voltage"></output></label><input class="form-range" data-topic="input/analog/battery/voltage" data-name="voltage" type="range" min="0" max="30" step="0.01" value="12"></div>
      <div class="col-md-6"><label class="form-label">Battery percentage <output data-output="battery"></output></label><input class="form-range" data-topic="input/analog/battery/percentage" data-name="battery" type="range" min="0" max="100" step="1" value="100"></div>
      <div class="col-md-6"><label class="form-label">Lights <output data-output="lights"></output></label><input class="form-range" data-topic="output/lights/left" data-name="lights" type="range" min="0" max="100" step="1" value="0"></div>
      <div class="col-md-6"><label class="form-label">Camera tilt <output data-output="cameraTilt"></output></label><input class="form-range" data-topic="sensor/camera/main/pitch" data-name="cameraTilt" type="range" min="-90" max="90" step="0.1" value="0"></div>
      <div class="col-md-6"><label class="form-label">Water temperature <output data-output="waterTemperature"></output></label><input class="form-range" data-topic="sensor/water/temperature" data-name="waterTemperature" type="range" min="-5" max="50" step="0.1" value="10"></div>
    </div>
    <output id="simulationStatus" class="d-block mt-3">Move a slider to send live telemetry.</output>
  </div>
</main>
{% endblock %}
{% block scripts %}
<script>
(() => { const fields=[...document.querySelectorAll('[data-topic]')]; const toggle=document.getElementById('simulationEnabled'); const warning=document.getElementById('simulationWarning'); const status=document.getElementById('simulationStatus'); let enabled=false; let timer; const units={depth:'m',voltage:'V',battery:'%',lights:'%',cameraTilt:'°',waterTemperature:'°C'}; const values=()=>Object.fromEntries(fields.map(f=>[f.dataset.topic, Number(f.value)])); const refresh=()=>fields.forEach(f=>document.querySelector(`[data-output="${f.dataset.name}"]`).textContent=`${Number(f.value).toFixed(f.step.includes('.')?2:0)} ${units[f.dataset.name]??'°'}`); const update=state=>{enabled=state; toggle.checked=state; warning.className=state?'alert alert-danger':'alert alert-secondary'; warning.textContent=state?'Simulation mode is ON. Slider changes are sent live to the Cockpit.':'Simulation mode is off. Enable it before moving sliders.'; window.dispatchEvent(new Event('cockpit-system-status-changed'));}; const send=()=>{if(!enabled)return; clearTimeout(timer); timer=setTimeout(async()=>{const response=await fetch('/api/development/simulation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values:values()})}); status.textContent=response.ok?'Live telemetry updated':'Enable simulation mode before sending fake telemetry';},40);}; fetch('/api/development/simulation/state').then(r=>r.json()).then(s=>update(s.enabled)); toggle.onchange=async()=>{const r=await fetch('/api/development/simulation/state',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:toggle.checked})}); update((await r.json()).enabled); if(enabled)send();}; fields.forEach(f=>f.addEventListener('input',()=>{refresh();send();})); refresh(); })();
</script>
{% endblock %}
