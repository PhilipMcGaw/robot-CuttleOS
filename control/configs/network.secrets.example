# Copy this file to configs/network.secrets.env on the robot and set permissions to 600.
# Add client identifiers to this array in connection-priority order. Identifiers
# may contain letters, digits, and underscores only.
WIFI_CLIENTS=(preferred)
WIFI_preferred_SSID=replace-me
WIFI_preferred_PASSWORD=replace-me
WIFI_preferred_PRIORITY=100
HOTSPOT_PASSWORD=replace-me
SMB_PASSWORD=replace-me
NATS_USERNAME=replace-me
NATS_PASSWORD=replace-me
