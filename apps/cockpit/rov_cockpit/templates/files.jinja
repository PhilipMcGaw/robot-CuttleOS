{% extends "base.jinja" %}
{% block title %}files — ROV{% endblock %}
{% block content %}


<main class="container py-4">
  <h1><i class="fa-solid fa-photo-film"></i> Media</h1>
  <p class="text-muted">Still images and Motion recordings stored on the ROV.</p>
  <div id="mediaMessage" class="alert d-none" role="alert"></div>

  <section class="card bg-dark-subtle p-3 mb-4">
    <h2 class="h4">Capture still image</h2>
    <div class="d-flex flex-wrap gap-2">
      {% for camera in cameras %}
      <button class="btn btn-primary capture-still" data-camera="{{ camera.id }}"><i class="fa-solid fa-camera"></i> Capture {{ camera.name }}</button>
      {% endfor %}
    </div>
  </section>

  <section class="card bg-dark-subtle p-3 mb-4">
    <h2 class="h4">Recording settings</h2>
    <label class="form-label" for="recordingMinutes">Recording segment length (minutes)</label>
    <div class="input-group" style="max-width: 300px">
      <input id="recordingMinutes" class="form-control" type="number" min="1" max="240" value="{{ media_config.recording_minutes }}">
      <button id="saveRecordingSettings" class="btn btn-primary">Save</button>
    </div>
    <div class="form-text">Default: 30 minutes. Restart Motion after changing this value.</div>
  </section>

  <section class="mb-4">
    <h2 class="h4">Still images</h2>
    <div class="row g-3">
      {% for still in stills %}
      <div class="col-12 col-sm-6 col-lg-4"><figure class="card bg-dark-subtle p-2 h-100 mb-0"><img class="img-fluid" src="/media/stills/{{ still.name }}" alt="{{ still.name }}"><figcaption class="small mt-2"><a href="/media/stills/{{ still.name }}" download><i class="fa-solid fa-download"></i> {{ still.name }}</a></figcaption></figure></div>
      {% else %}<p class="text-muted">No still images have been captured.</p>{% endfor %}
    </div>
  </section>

  <section>
    <h2 class="h4">Video recordings</h2>
    <div class="list-group">
      {% for video in videos %}<div class="list-group-item bg-dark-subtle d-flex justify-content-between align-items-center"><span><i class="fa-solid fa-video"></i> {{ video.name }}</span><a class="btn btn-sm btn-outline-primary" href="/media/videos/{{ video.name }}" download><i class="fa-solid fa-download"></i> Download</a></div>
      {% else %}<p class="text-muted">No video recordings found.</p>{% endfor %}
    </div>
  </section>
</main>
{% endblock %}
{% block scripts %}
<script>
for (const button of document.querySelectorAll('.capture-still')) {
  button.addEventListener('click', async () => {
    button.disabled = true;
    try {
      const response = await fetch(`/api/cameras/${button.dataset.camera}/still`, {method: 'POST'});
      const result = await response.json();
      if (!response.ok) throw new Error(result.detail || 'Capture failed');
      location.reload();
    } catch (error) {
      const message = document.getElementById('mediaMessage');
      message.className = 'alert alert-danger';
      message.textContent = error.message;
      button.disabled = false;
    }
  });
}
</script>
<script>
document.getElementById('saveRecordingSettings').addEventListener('click', async () => {
  const input = document.getElementById('recordingMinutes');
  const response = await fetch('/api/media/config', {method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({recording_minutes: Number(input.value)})});
  const message = document.getElementById('mediaMessage');
  message.className = response.ok ? 'alert alert-success' : 'alert alert-danger';
  message.textContent = response.ok ? 'Recording length saved. Restart Motion to apply it.' : 'Could not save recording length.';
});
</script>
{% endblock %}



