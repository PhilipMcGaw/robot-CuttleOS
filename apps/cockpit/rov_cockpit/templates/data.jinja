{% extends "base.jinja" %}
{% block title %}data — ROV{% endblock %}
{% block content %}

<main class="container py-4">
  <h1><i class="fa-solid fa-table-list"></i> Sensor data</h1>
  <p class="text-muted">Select a CSV export and sensor fields to display or download.</p>
  <div id="dataMessage" class="alert d-none" role="alert"></div>
  <section class="card bg-dark-subtle p-3 mb-4">
    <label class="form-label" for="csvFile">CSV export</label>
    <select id="csvFile" class="form-select mb-3"><option value="">Select a CSV export</option>{% for file in files %}<option value="{{ file.relative }}">{{ file.name }}</option>{% endfor %}</select>
    <label class="form-label" for="sensorFields">Sensor fields</label>
    <select id="sensorFields" class="form-select mb-3" multiple size="6" disabled></select>
    <div class="d-flex flex-wrap gap-2"><button id="previewData" class="btn btn-primary" disabled><i class="fa-solid fa-eye"></i> Display data</button><button id="downloadData" class="btn btn-outline-primary" disabled><i class="fa-solid fa-download"></i> Download selected CSV</button></div>
    <div class="form-text">On-screen output is limited to 250 rows; downloads include all matching rows.</div>
  </section>
  <section class="card bg-dark-subtle p-3"><div class="table-responsive"><table class="table table-dark table-sm" id="dataTable"><thead></thead><tbody><tr><td class="text-muted">Choose an export to begin.</td></tr></tbody></table></div></section>
</main>
{% endblock %}
{% block scripts %}
<script>
const fileSelect=document.getElementById('csvFile'), fieldSelect=document.getElementById('sensorFields'), preview=document.getElementById('previewData'), download=document.getElementById('downloadData'), message=document.getElementById('dataMessage');
const fields=()=>Array.from(fieldSelect.selectedOptions).map(option=>option.value);
const notify=(text,kind='danger')=>{message.className=`alert alert-${kind}`;message.textContent=text;};
fileSelect.addEventListener('change',async()=>{fieldSelect.replaceChildren();fieldSelect.disabled=!fileSelect.value;preview.disabled=!fileSelect.value;download.disabled=!fileSelect.value;if(!fileSelect.value)return;const response=await fetch(`/api/data/fields?file=${encodeURIComponent(fileSelect.value)}`);const result=await response.json();if(!response.ok)return notify(result.detail||'Could not read the CSV fields.');for(const field of result.fields)fieldSelect.add(new Option(field,field,true,true));});
preview.addEventListener('click',async()=>{const query=new URLSearchParams({file:fileSelect.value,sensors:fields().join(','),limit:'250'});const response=await fetch(`/api/data/preview?${query}`);const result=await response.json();if(!response.ok)return notify(result.detail||'Could not display the CSV data.');document.querySelector('#dataTable thead').innerHTML=`<tr>${result.fields.map(field=>`<th>${field}</th>`).join('')}</tr>`;document.querySelector('#dataTable tbody').innerHTML=result.rows.map(row=>`<tr>${row.map(value=>`<td>${value}</td>`).join('')}</tr>`).join('')||'<tr><td class="text-muted">No rows found.</td></tr>';notify(`Displayed ${result.rows.length} row(s).`,'success');});
download.addEventListener('click',()=>{const query=new URLSearchParams({file:fileSelect.value,sensors:fields().join(',')});window.location.href=`/api/data/download?${query}`;});
</script>
{% endblock %}



