{% extends "base.jinja" %}
{% block title %}gamepad — ROV{% endblock %}
{% block content %}


<main class="container py-4">
  <h1><i class="fa-solid fa-gamepad"></i> Gamepad customisation</h1>
  <p class="text-muted">Pair the controller with this computer, then press a button or move a stick. Settings are saved in this browser.</p>

  <div id="gamepadStatus" class="alert alert-warning">No gamepad detected</div>
  <div class="card bg-dark-subtle p-3">
    <h2 class="h4">Control mapping</h2>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Throttle axis</label><select class="form-select" data-setting="throttleAxis"><option value="1">Left stick vertical</option><option value="3">Right stick vertical</option></select></div>
      <div class="col-md-6"><label class="form-label">Steering axis</label><select class="form-select" data-setting="steeringAxis"><option value="0">Left stick horizontal</option><option value="2">Right stick horizontal</option></select></div>
      <div class="col-md-6"><label class="form-label">Vertical movement axis</label><select class="form-select" data-setting="verticalAxis"><option value="3">Right stick vertical</option><option value="1">Left stick vertical</option></select></div>
      <div class="col-md-6"><label class="form-label">Camera pan axis</label><select class="form-select" data-setting="cameraPanAxis"><option value="2">Right stick horizontal</option><option value="0">Left stick horizontal</option></select></div>
      <div class="col-md-6"><label class="form-label">Dead zone</label><input class="form-range" type="range" min="0" max="0.4" step="0.01" data-setting="deadZone"><output data-output="deadZone"></output></div>
      <div class="col-md-6"><label class="form-label">Sensitivity</label><input class="form-range" type="range" min="0.2" max="1" step="0.05" data-setting="sensitivity"><output data-output="sensitivity"></output></div>
      <div class="col-md-6"><label class="form-label">Arm button</label><select class="form-select" data-setting="armButton"><option value="0">Button 1</option><option value="1">Button 2</option><option value="2">Button 3</option><option value="3">Button 4</option></select></div>
      <div class="col-md-6"><label class="form-label">Dead-man button</label><select class="form-select" data-setting="deadmanButton"><option value="4">Left shoulder</option><option value="5">Right shoulder</option><option value="0">Button 1</option></select></div>
    </div>
    <div class="mt-3">
      <button id="saveGamepad" class="btn btn-primary">Save settings</button>
      <button id="resetGamepad" class="btn btn-outline-secondary">Restore defaults</button>
    </div>
  </div>

  <div class="card bg-dark-subtle p-3 mt-4">
    <h2 class="h4">Live input monitor</h2>
    <pre id="gamepadAxes" class="mb-0">Move a control to see its value.</pre>
  </div>
</main>
{% endblock %}
{% block scripts %}
<script>
(() => {
  const defaults = {throttleAxis: '1', steeringAxis: '0', verticalAxis: '3', cameraPanAxis: '2', deadZone: '0.12', sensitivity: '0.75', armButton: '0', deadmanButton: '4'};
  const key = 'rov.gamepad.settings';
  const settings = {...defaults, ...(JSON.parse(localStorage.getItem(key) || '{}'))};
  const fields = document.querySelectorAll('[data-setting]');
  const status = document.getElementById('gamepadStatus');
  const output = document.querySelectorAll('[data-output]');
  function load() { fields.forEach(field => field.value = settings[field.dataset.setting]); output.forEach(item => item.textContent = settings[item.dataset.output]); }
  function save() { fields.forEach(field => settings[field.dataset.setting] = field.value); localStorage.setItem(key, JSON.stringify(settings)); load(); }
  fields.forEach(field => field.addEventListener('input', () => { const target = document.querySelector(`[data-output="${field.dataset.setting}"]`); if (target) target.textContent = field.value; }));
  document.getElementById('saveGamepad').onclick = save;
  document.getElementById('resetGamepad').onclick = () => { Object.assign(settings, defaults); save(); };
  load();

  function poll() {
    const pad = [...(navigator.getGamepads ? navigator.getGamepads() : [])].find(Boolean);
    if (pad) {
      status.className = 'alert alert-success';
      status.textContent = `Connected: ${pad.id}`;
      document.getElementById('gamepadAxes').textContent = `Axes: ${pad.axes.map((value, index) => `${index}: ${value.toFixed(2)}`).join(' | ')}\nButtons pressed: ${pad.buttons.map((button, index) => button.pressed ? index : null).filter(index => index !== null).join(', ') || 'none'}`;
    }
    requestAnimationFrame(poll);
  }
  window.addEventListener('gamepadconnected', event => { status.className = 'alert alert-success'; status.textContent = `Connected: ${event.gamepad.id}`; });
  window.addEventListener('gamepaddisconnected', () => { status.className = 'alert alert-warning'; status.textContent = 'No gamepad detected'; });
  poll();
})();
</script>
{% endblock %}



